{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/kreasi", "destination": "/kreasi/index.html" },
    { "source": "/kreasi/", "destination": "/kreasi/index.html" },
    { "source": "/kreasi-ide", "destination": "/kreasi/ide.html" },
    { "source": "/kreasi-tulis", "destination": "/kreasi/tulis.html" },
    { "source": "/kreasi-hasil", "destination": "/kreasi/hasil.html" },
    { "source": "/kreasi-bedah", "destination": "/kreasi/bedah.html" },
    { "source": "/kreasi-penghubung", "destination": "/kreasi/penghubung.html" },
    { "source": "/kreasi-tandingan", "destination": "/kreasi/tandingan.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, Authorization" }
      ]
    }
  ]
}
